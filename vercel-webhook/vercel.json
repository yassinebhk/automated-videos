  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/legal/tos", "destination": "/api/legal?page=tos" },
    { "source": "/legal/tos.html", "destination": "/api/legal?page=tos" },
    { "source": "/legal/privacy", "destination": "/api/legal?page=privacy" },
    { "source": "/legal/privacy.html", "destination": "/api/legal?page=privacy" },
    { "source": "/tiktok:token.txt", "destination": "/api/tiktok-verify" }
  ]
}
