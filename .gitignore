.env
secrets/
# output/ contiene videos generados (no queremos en el repo), pero SÍ persistimos
# el snapshot analytics como append-only para tener historial en Actions.
output/**
!output/stats_history.jsonl
!output/reddit_history.json
!output/pinned_summary_id.txt
!output/case_ledger.json
!output/backfill_log.json
# Los youtube.json + youtube_long.json (100 bytes cada uno) son metadata
# necesaria para backfill (slug → video_id). Sin ellos, GH Actions runner
# no encuentra los Shorts para reciclar.
!output/uploaded/
!output/uploaded/**/
!output/uploaded/**/youtube.json
!output/uploaded/**/youtube_long.json
# Podcast feed + episodios se sirven vía GitHub Pages
!docs/
!docs/**
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/
build/
dist/
.DS_Store
music/*.mp3
!music/.gitkeep
# Logs locales del bot Mac (no van al repo)
/tmp/videogen_bot.log
*.log
