# --- Required for script generation + Veo hook ---
# Get free at https://aistudio.google.com/app/apikey (free tier: 1500 req/día)
GEMINI_API_KEY=

# --- Voice engine: "edge" (gratis, ilimitado, por defecto) | "elevenlabs" (pago) ---
VOICE_ENGINE=edge
# Voces Edge (neuronales Microsoft). Lista: edge-tts --list-voices
EDGE_VOICE_ES=es-ES-AlvaroNeural
EDGE_VOICE_EN=en-US-GuyNeural

# --- Solo si VOICE_ENGINE=elevenlabs (mejor calidad, de pago) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_ES=
ELEVENLABS_VOICE_ID_EN=

# --- Required for B-roll footage ---
# Get free at https://www.pexels.com/api/
PEXELS_API_KEY=xxx

# --- YouTube upload (OAuth) ---
# Download client_secret.json from Google Cloud Console (YouTube Data API v3)
# Place it at: ./secrets/youtube_client_secret.json
# First upload triggers OAuth flow, tokens cached in ./secrets/youtube_token.json
YOUTUBE_CHANNEL_ID_ES=
YOUTUBE_CHANNEL_ID_EN=

# --- Optional: Pollinations token (imágenes IA, tier registrado) ---
# Regístrate gratis en https://auth.pollinations.ai → más límite que anónimo
POLLINATIONS_TOKEN=

# --- Telegram bot (genera/aprueba/sube + resumen diario) ---
# Crea el bot con @BotFather → /newbot → copia el token
TELEGRAM_BOT_TOKEN=
# Tu chat id (el bot te lo dice al hacer /start). Para el resumen diario.
TELEGRAM_CHAT_ID=
# Hora del resumen diario (HH:MM, 24h, hora local)
TELEGRAM_DAILY_HOUR=09:00

# --- Optional: model + defaults ---
VIDEO_DEFAULT_DURATION_SECONDS=60
